{
  "name": "oboete",
  "version": "0.1.0-alpha.0",
  "description": "Automatic shared memory for Claude Code, Codex, Grok Build, and Pi.",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "bin": {
    "oboete": "dist/oboete.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p src/viewer/app --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test --enable-source-maps --import ./build/test/helpers/compile-cache.mjs 'build/test/unit/**/*.test.mjs' 'build/test/migrations/**/*.test.mjs' 'scripts/e2e/**/*.test.mjs' 'scripts/dco-check.test.mjs' 'scripts/pack-check.test.mjs' && node --test --enable-source-maps --import ./build/test/helpers/compile-cache.mjs --test-concurrency=1 'build/test/e2e-*.test.mjs' 'build/test/fault-*.test.mjs' 'scripts/quality-debt-record*.test.mjs'",
    "pack-check": "node scripts/pack-check.mjs",
    "test:coverage": "npm run build && node --test --enable-source-maps --experimental-test-coverage 'build/test/**/*.test.mjs'"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.78",
    "@ai-sdk/provider": "4.0.34",
    "@hono/node-server": "2.1.5",
    "ai": "7.0.153",
    "hono": "4.13.14",
    "workers-ai-provider": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/core": "13.0.7",
    "@secretlint/profiler": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@secretlint/types": "13.0.7",
    "@types/node": "22.20.1",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "preact": "10.29.8",
    "smol-toml": "1.9.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
